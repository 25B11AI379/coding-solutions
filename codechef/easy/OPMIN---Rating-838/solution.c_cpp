class Solution {
public:
    int countNonMinimum(vector<int>& nums) {
        // write your code here 
        int min_val = nums[0];
        for (int i = 1; i < nums.size(); i++) {
            if (nums[i] < min_val) {
                min_val = nums[i];
            }
        }
        int operations = 0;
        for (int i = 0; i < nums.size(); i++) {
            if (nums[i] != min_val) {
                operations++;
            }
        }
        return operations;
    }
};
