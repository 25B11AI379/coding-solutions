class Solution {
public:
    int countNonMinimum(vector<int>& nums) {
        // write your code here 
           int min_val = nums[0];
        for (int x : nums) {
            if (x < min_val) {
                min_val = x;
            }
        }
        int operations = 0;
        for (int x : nums) {
            if (x > min_val) {
                operations++;
            }
        }
        return operations;
    }
};
