#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        int d[n];
        for(int i=0;i<n;i++){
            cin>>d[i];
        }
        // your code goes here
         bool is_sorted = true;
        for(int i = 1; i < n; i++) {
            if(d[i] < d[i-1]) {
                is_sorted = false;
                break;
            }
        }
        if(is_sorted) {
            cout << "Yes" << endl;
        } else {
            cout << "No" << endl;
        }
    }

}
