#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int main() {
    int t;
    if (!(cin >> t)) return 0;

    while (t--) {
        int n;
        cin >> n;
        vector<long long> a(n);
        for (int i = 0; i < n; ++i) {
            cin >> a[i];
        }
        long long current_sum = 0;
        long long min_seen = 0;
        bool deleted = false;
        bool possible = true;
        for (int i = 0; i < n; ++i) {
            current_sum += a[i];
            if (a[i] < min_seen) {
                min_seen = a[i];
            }
            if (current_sum < 0) {
                if (!deleted) {
                    current_sum -= min_seen;
                    deleted = true;
                    min_seen = 0;
                    if (current_sum < 0) {
                        possible = false;
                        break;
                    }
                } else {
                    possible = false;
                    break;
                }
            }
        }
        if (possible) {
            cout << "Yes\n";
        } else {
            cout << "No\n";
        }
    }

    return 0;
}