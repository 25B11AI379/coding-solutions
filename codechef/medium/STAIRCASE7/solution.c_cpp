#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    map<int,int>counts;
        int max_freq=0;
        for (int i=1;i<=n;i++) {
            int val;
            cin>>val;
            int diff=val-i;
            counts[diff]++;
            max_freq=max(max_freq,counts[diff]);
        }
        cout<<n-max_freq<<endl;
	}
}
